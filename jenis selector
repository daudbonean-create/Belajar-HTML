#CSS-NYA

/* universal selector*/
 * {
    font-family: Arial, Helvetica, sans-serif;
 }

 /* type selector */
 h1 {
    color: gold;
 }
 

 h2 {
    color: coral;
 }

 /* class selector */
 .sarapan {
    color: darkgoldenrod;
 }

 /* class id (memanggil berdasarkan id) */
 #maksi {
    color: rgb(57, 163, 128);
 }

/* class child */

p>b {
    color: fuchsia;
}

li>b {
    color: brown;
}

/* decedant selector */
p b {
    color: hotpink; 
}
