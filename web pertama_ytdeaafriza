#CSS
*,
html{
    margin: 0;
    padding: 0;
}

body {
    height: 100vh;
}

.navbar-ctn {
    background-color: mediumseagreen;
    width: 100%;
    height: 15vh;


}

.ul-navbar {
    display: flex;
    height: 100px;
    justify-content: center;
    align-items: center;
    
    
}

.li-navbar {
    font-size: 30px;
    list-style-type: none;
    padding: 20px;
    color: white;
    margin: 5px;
    
}

.container-content {
    background-color: black;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 75vh;

}

.img-content {
    width: 60%%;
    height: 40%;
    justify-content: center;


.a-content {
    width: 1080px;
    height: 720px;
    background-color: white;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

    
    
    
}

.container-footer {
    height: 10vh;
    background-color: beige;
    display: flex;
    justify-content: center;
    align-items: center;

}

.h1-footer {
    font-size: 50px;
    background-color: white;
}

.li-navbar:hover{
    background-color: black;
    transition-duration: 0.5s ease-in-out;
    transition-delay: 0.1s;
    border-radius: 5px;
    
}
